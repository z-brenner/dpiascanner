# Build settings for the public demo on Cloudflare: `pnpm run build:cf` (vite --mode cloudflare).
# A self-hosted build (`pnpm run build`) does not read this file and shows no demo notice.
# VITE_OPERATOR_CONTACT and VITE_BACKEND_HOST come from the deploy workflow (repository
# variables LANTERN_OPERATOR_CONTACT and LANTERN_BACKEND_HOST); set them in the environment for
# a manual build. Nothing here is secret: it all ends up in the public JavaScript bundle.
VITE_DEMO_NOTICE=1
VITE_SOURCE_URL=https://github.com/z-brenner/dpiascanner
