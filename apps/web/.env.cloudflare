# Build settings for the public demo on Cloudflare: `pnpm run build:cf` (vite --mode cloudflare).
# A self-hosted build (`pnpm run build`) does not read this file and shows no demo notice.
# VITE_OPERATOR_CONTACT, VITE_BACKEND_HOST and VITE_BACKUP_DAYS come from the deploy workflow
# (repository variables LANTERN_OPERATOR_CONTACT, LANTERN_BACKEND_HOST and LANTERN_BACKUP_DAYS);
# set them in the environment for a manual build. Nothing here is secret: it all ends up in the public JavaScript bundle.
VITE_DEMO_NOTICE=1
VITE_SOURCE_URL=https://github.com/z-brenner/dpiascanner
