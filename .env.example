# Copy to .env for `docker compose --profile app` (and `--profile tunnel`). Never commit .env.
# Variables are read by lantern_platform.config.Settings unless noted.

# GitHub App (docs/github-app.md)
GITHUB_APP_ID=
GITHUB_APP_SLUG=lantern-dpia
# The PEM itself (literal \n sequences are accepted), or a path in GITHUB_APP_PRIVATE_KEY_PATH.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Fernet key for tokens at rest:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
LANTERN_TOKEN_KEY=

# The site's origin: CORS and links in reports and PR comments.
LANTERN_WEB_URL=http://localhost:5173
# 1 behind https (always, in production); 0 only for plain-http local testing.
LANTERN_COOKIE_SECURE=1

# Limits
LANTERN_RUNS_PER_HOUR=10
LANTERN_RUN_TIMEOUT_S=1800
LANTERN_CLONE_MAX_MB=500
# process | container
LANTERN_JOB_ISOLATION=process
LANTERN_WORKER_IMAGE=lantern-worker:latest
# Extra hosts the worker may reach, comma-separated, on top of GitHub, PyPI, npm, Anthropic.
LANTERN_EGRESS_ALLOWLIST=

# Decision provider (packages/decisions): stub, or jev with the TypeSafe credentials.
LANTERN_DECISION_PROVIDER=stub
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=

# Optional LLM narrative drafter (packages/report); it sees code-free finding briefs only.
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5; an empty value would override the default, so leave it commented.
# LANTERN_NARRATIVE_MODEL=

# Cloudflare Tunnel token for the `tunnel` profile (docs/deploy-cloudflare.md).
CLOUDFLARE_TUNNEL_TOKEN=

# The public demo (docs/deploy-render.md): public repositories only, and delete runs and
# inactive users after this many hours (0 keeps everything). Sessions last this long too.
LANTERN_PUBLIC_REPOS_ONLY=0
LANTERN_RETENTION_HOURS=0
LANTERN_SESSION_TTL_HOURS=168
# When the API's hostname is public, only requests carrying this secret are served (the web
# app's Cloudflare Worker sends it as API_PROXY_SECRET). /healthz stays open.
LANTERN_PROXY_SECRET=
